# Copia este archivo a .env.local. Vite solo expone al navegador las variables VITE_*, asi
# que aqui no va ningun secreto: todo lo que se escriba llega al cliente.

# Origen de cada servicio. En desarrollo apuntan al proxy de Vite (vite.config.ts), que los
# sirve bajo el mismo origen que la aplicacion. Sin eso la cookie httpOnly de sesion que
# emite ecilost-auth-service viajaria entre origenes distintos y el navegador la bloquearia.
# Cuando ecilost-api-gateway este en pie, las dos pasan a ser su URL publica.
VITE_AUTH_BASE_URL=/auth
VITE_CATALOG_BASE_URL=/api/catalog
VITE_WALLET_BASE_URL=/api/wallet
VITE_AUCTION_BASE_URL=/api/auction

# `true` usa las subastas de demostracion en memoria (rivales simulados) en lugar de
# ecilost-auction-service. Cualquier otro valor, o ninguno, usa el servicio real.
VITE_AUCTIONS_DEMO=false
